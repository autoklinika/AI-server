  ],
  "candidate_models": [
    "reasoning-main",
    "qwen3.8:27b",
    "qwen3.8-flash-next",
    "gpt-oss:20b",
    "gpt-oss:120b",
    "mistral-small-4-119b",
    "deepseek-v4.1-flash-reference",
    "glm-5.3-flash-reference"
