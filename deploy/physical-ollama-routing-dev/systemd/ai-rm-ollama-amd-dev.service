# DEV DRAFT — NOT INSTALLED, NOT ENABLED, NOT AUTHORIZED FOR PRODUCTION
# System-manager service, not a user-manager transient unit.
[Unit]
Description=DEV-only AMD Radeon 890M physically isolated small Ollama
After=local-fs.target
ConditionPathExists=/sys/bus/pci/devices/0000:c6:00.0

[Service]
Type=simple
User=ollama
Group=ollama
ExecStart=/usr/local/bin/ollama serve
Restart=no
KillMode=control-group
RuntimeMaxSec=360
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/dri/renderD128 rw
MemoryAccounting=yes
MemoryHigh=4G
MemoryMax=6G
MemorySwapMax=0
TasksMax=128
ProtectSystem=strict
ProtectHome=yes
StateDirectory=ai-rm-ollama-amd-dev
WorkingDirectory=/var/lib/ai-rm-ollama-amd-dev
UMask=0077
Environment=OLLAMA_HOST=127.0.0.1:11646
Environment=OLLAMA_MODELS=/var/lib/ai-rm-ollama-amd-dev/models
Environment=OLLAMA_VULKAN=1
Environment=OLLAMA_IGPU_ENABLE=1
Environment=GGML_VK_VISIBLE_DEVICES=1
Environment=CUDA_VISIBLE_DEVICES=-1
Environment=OLLAMA_MAX_LOADED_MODELS=1
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_KEEP_ALIVE=0
Environment=OLLAMA_NO_CLOUD=true
