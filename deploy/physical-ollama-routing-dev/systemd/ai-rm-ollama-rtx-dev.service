# DEV DRAFT — NOT INSTALLED, NOT ENABLED, NOT AUTHORIZED FOR PRODUCTION
[Unit]
Description=DEV-only RTX 5060 Ti physically isolated small Ollama
Requires=ai-egpu-gen3-ha.service
After=ai-egpu-gen3-ha.service
ConditionPathExists=/sys/bus/pci/devices/0000:03:00.0

[Service]
Type=simple
User=ollama
Group=ollama
ExecStart=/usr/local/bin/ollama serve
Restart=no
KillMode=control-group
RuntimeMaxSec=360
TimeoutStopSec=15
NoNewPrivileges=yes
PrivateDevices=no
DevicePolicy=closed
DeviceAllow=/dev/nvidia0 rw
DeviceAllow=/dev/nvidiactl rw
DeviceAllow=/dev/nvidia-uvm rw
DeviceAllow=/dev/nvidia-uvm-tools rw
MemoryAccounting=yes
MemoryHigh=3G
MemoryMax=4G
MemorySwapMax=0
TasksMax=128
ProtectSystem=strict
ProtectHome=yes
StateDirectory=ai-rm-ollama-rtx-dev
WorkingDirectory=/var/lib/ai-rm-ollama-rtx-dev
UMask=0077
Environment=OLLAMA_HOST=127.0.0.1:11647
Environment=OLLAMA_MODELS=/var/lib/ai-rm-ollama-rtx-dev/models
Environment=OLLAMA_VULKAN=0
Environment=OLLAMA_IGPU_ENABLE=0
Environment=CUDA_VISIBLE_DEVICES=0
Environment=HIP_VISIBLE_DEVICES=-1
Environment=ROCR_VISIBLE_DEVICES=-1
Environment=OLLAMA_MAX_LOADED_MODELS=2
Environment=OLLAMA_NUM_PARALLEL=1
Environment=OLLAMA_CONTEXT_LENGTH=4096
Environment=OLLAMA_KEEP_ALIVE=0
Environment=OLLAMA_NO_CLOUD=true
