[Unit]
Description=AI Platform Stage K daily backup
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/AI-server
Environment=PYTHONUNBUFFERED=1
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
ExecStart=/opt/ai-platform/current/services/ai-bridge/.venv/bin/python %h/AI-server/deploy/stage-k/k5_run.py daily
TimeoutStartSec=1h
