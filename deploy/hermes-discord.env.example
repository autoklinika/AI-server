# Merge locally into the existing private HERMES_HOME/.env; never replace it.
DISCORD_BOT_TOKEN=<BOT_TOKEN>
DISCORD_ALLOWED_USERS=<OWNER_USER_ID>

# Discord technical-only AI Platform policy.
# Text/voice queries are sent only to Knowledge /knowledge/ask in this domain.
AI_PLATFORM_DISCORD_KNOWLEDGE_DOMAIN=ecu-repair
AI_PLATFORM_DISCORD_KNOWLEDGE_URL=http://127.0.0.1:11435/api/v1/knowledge/ask

# Optional clickable source links in Discord replies.
# Point this at a Control Center URL reachable from your Discord client.
# Example: http://ai-server:8080/control
AI_PLATFORM_DISCORD_SOURCE_BASE_URL=
