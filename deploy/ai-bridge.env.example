# Copy to /etc/ai-bridge/ai-bridge.env on the AI Server.
# Never commit the real database password.
AI_BRIDGE_HOST=0.0.0.0
AI_BRIDGE_NODE_ID=ai-node-01
AI_BRIDGE_PORT=8080
AI_BRIDGE_LOG_LEVEL=INFO
AI_BRIDGE_DATABASE_URL=postgresql+psycopg://ai_bridge:CHANGE_ME@127.0.0.1:5432/ai_bridge

# Direct Ollama backend. AI Gateway always uses this URL as its upstream.
AI_BRIDGE_OLLAMA_URL=http://127.0.0.1:11434
AI_BRIDGE_OLLAMA_MODEL=qwen3.6:35b
AI_BRIDGE_OLLAMA_ANALYSIS_TIMEOUT_SECONDS=300

# Central local inference gateway / scheduler.
AI_BRIDGE_GATEWAY_HOST=127.0.0.1
AI_BRIDGE_GATEWAY_PORT=11435
AI_BRIDGE_GATEWAY_URL=http://127.0.0.1:11435
AI_BRIDGE_GATEWAY_MAX_CONCURRENCY=1
AI_BRIDGE_GATEWAY_MAX_QUEUE_SIZE=128
AI_BRIDGE_GATEWAY_CONNECT_TIMEOUT_SECONDS=5
AI_BRIDGE_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=600
AI_BRIDGE_GATEWAY_HEALTH_TIMEOUT_SECONDS=2
# D.3 static inventory defaults to Ollama/ComfyUI/Hermes on AI_BRIDGE_NODE_ID.
# Optional AI_BRIDGE_GATEWAY_REGISTRY takes a JSON object, not a filename.
# Schema/example: deploy/gateway-registry.example.json. Omit to derive defaults.
# D.3 validates existing single-node bindings; this does not enable routing.
# Lower number = higher priority.
AI_BRIDGE_GATEWAY_PRIORITY_VENTILATION=10
AI_BRIDGE_GATEWAY_PRIORITY_INTERACTIVE=50
AI_BRIDGE_GATEWAY_PRIORITY_NORMAL=100
AI_BRIDGE_GATEWAY_PRIORITY_BACKGROUND=200

# Knowledge Service internal dense index baseline (Stage J2/J3).
# These values are deployment details, not public client contract fields.
AI_BRIDGE_KNOWLEDGE_QDRANT_URL=http://127.0.0.1:6333
AI_BRIDGE_KNOWLEDGE_QDRANT_COLLECTION=knowledge_dense_bge_m3_1024_v1
AI_BRIDGE_KNOWLEDGE_EMBEDDING_MODEL=bge-m3
AI_BRIDGE_KNOWLEDGE_EMBEDDING_DIMENSIONS=1024
AI_BRIDGE_KNOWLEDGE_CHUNK_MAX_CHARS=2400
AI_BRIDGE_KNOWLEDGE_CHUNK_PROFILE=md-heading-2400-v1
AI_BRIDGE_KNOWLEDGE_PDF_CHUNK_PROFILE=pdf-page-2400-v1
AI_BRIDGE_KNOWLEDGE_INDEX_PROFILE=dense-bge-m3-1024-cosine-v1
AI_BRIDGE_KNOWLEDGE_OBJECT_STORE_DIR=/srv/ai-data/knowledge/canonical/objects
AI_BRIDGE_KNOWLEDGE_PDF_TESSERACT=/srv/ai-data/tools/tesseract-portable/root/usr/bin/tesseract
AI_BRIDGE_KNOWLEDGE_PDF_TESSDATA_DIR=/srv/ai-data/tools/tesseract-portable/root/usr/share/tesseract-ocr/5/tessdata
AI_BRIDGE_KNOWLEDGE_PDF_TESSERACT_LIB_DIR=/srv/ai-data/tools/tesseract-portable/root/usr/lib/x86_64-linux-gnu
AI_BRIDGE_KNOWLEDGE_PDF_OCR_LANGUAGES=eng+pol
AI_BRIDGE_KNOWLEDGE_PDF_OCR_MIN_ALNUM=80
AI_BRIDGE_KNOWLEDGE_RAG_MAX_SOURCES=8
AI_BRIDGE_KNOWLEDGE_RAG_CONTEXT_MAX_CHARS=24000

# Production default: route WVC analysis through AI Gateway / admission control.
# Set false only for explicit recovery/debug compatibility bypass.
AI_BRIDGE_ANALYSIS_USE_GATEWAY=true

AI_BRIDGE_ANALYSIS_WINDOW_MINUTES=15
# With CM5 capture every 5 s a full 15-minute window contains about 180 samples.
# 120 is a deterministic data-quality gate, not an anomaly threshold.
AI_BRIDGE_ANALYSIS_MIN_SAMPLES=120
AI_BRIDGE_ANALYSIS_TEMPERATURE=0
AI_BRIDGE_VENTILATION_SOURCE_ID=workshop-ventilation-cm5-01
AI_BRIDGE_TELEMETRY_MAX_BODY_BYTES=1048576
