# Copy to /etc/ai-gateway/ai-gateway.env on the AI Server.
# The gateway is local-only and forwards inference to the existing Ollama service.
AI_BRIDGE_LOG_LEVEL=INFO
AI_BRIDGE_OLLAMA_URL=http://127.0.0.1:11434
AI_BRIDGE_GATEWAY_HOST=127.0.0.1
AI_BRIDGE_GATEWAY_PORT=11435
AI_BRIDGE_GATEWAY_URL=http://127.0.0.1:11435
AI_BRIDGE_GATEWAY_MAX_CONCURRENCY=1
AI_BRIDGE_GATEWAY_MAX_QUEUE_SIZE=128
AI_BRIDGE_GATEWAY_CONNECT_TIMEOUT_SECONDS=5
AI_BRIDGE_GATEWAY_UPSTREAM_TIMEOUT_SECONDS=600
AI_BRIDGE_GATEWAY_HEALTH_TIMEOUT_SECONDS=2
AI_BRIDGE_GATEWAY_PRIORITY_VENTILATION=10
AI_BRIDGE_GATEWAY_PRIORITY_INTERACTIVE=50
AI_BRIDGE_GATEWAY_PRIORITY_NORMAL=100
AI_BRIDGE_GATEWAY_PRIORITY_BACKGROUND=200
