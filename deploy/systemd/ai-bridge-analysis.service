[Unit]
Description=AI Bridge ventilation advisory analysis
After=network-online.target postgresql.service ollama.service
Wants=network-online.target
ConditionPathExists=/opt/ai-bridge/.venv/bin/ai-bridge-analyze-ventilation

[Service]
Type=oneshot
User=harrypotter
Group=harrypotter
WorkingDirectory=/opt/ai-bridge
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=/etc/ai-bridge/ai-bridge.env
ExecStart=/opt/ai-bridge/.venv/bin/ai-bridge-analyze-ventilation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-bridge
