[Unit]
Description=AI Bridge ventilation advisory analysis
After=network-online.target postgresql.service ai-gateway.service
Wants=network-online.target
Requires=ai-gateway.service
ConditionPathExists=/opt/ai-platform/current/services/ai-bridge/.venv/bin/ai-bridge-analyze-ventilation

[Service]
Type=oneshot
User=harrypotter
Group=harrypotter
WorkingDirectory=/opt/ai-platform/current/services/ai-bridge
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONPATH=/opt/ai-platform/current/services/ai-bridge/src"
EnvironmentFile=/etc/ai-bridge/ai-bridge.env
ExecStart=/opt/ai-platform/current/services/ai-bridge/.venv/bin/ai-bridge-analyze-ventilation
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ai-bridge
