[Unit]
Description=AI Gateway / Resource Manager admission service
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=harrypotter
Group=harrypotter
WorkingDirectory=/opt/ai-platform/current/services/ai-gateway
EnvironmentFile=/etc/ai-gateway/ai-gateway.env
Environment="PYTHONPATH=/opt/ai-platform/current/services/ai-gateway/src"
ExecStart=/opt/ai-platform/current/services/ai-gateway/.venv/bin/python -m ai_bridge.gateway.main
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
