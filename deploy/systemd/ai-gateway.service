[Unit]
Description=AI Gateway priority scheduler for local inference
After=network-online.target ollama.service
Wants=network-online.target
Requires=ollama.service

[Service]
Type=simple
User=harrypotter
Group=harrypotter
WorkingDirectory=/opt/ai-gateway
EnvironmentFile=/etc/ai-gateway/ai-gateway.env
ExecStart=/opt/ai-gateway/.venv/bin/ai-gateway
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
