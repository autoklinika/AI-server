{
  // Zachowuje obecny pełny dostęp użytkowników należących do Twojego tailnetu.
  // Nie obejmuje osób korzystających wyłącznie z udostępnienia urządzenia.
  "grants": [
    {
      "src": ["autogroup:member"],
      "dst": ["*"],
      "ip": ["*"]
    },
    // Osoby zewnętrzne, którym udostępniono maszynę:
    // tylko Magazyn V1 na AI Server przez HTTPS/TCP 8443.
    {
      "src": ["autogroup:shared"],
      "dst": ["100.112.82.87"],
      "ip": ["tcp:8443"]
    }
  ],

  // Zachowane bez zmian względem aktualnej konfiguracji użytkownika.
  "ssh": [
    {
      "action": "check",
      "src": ["autogroup:member"],
      "dst": ["autogroup:self"],
      "users": ["autogroup:nonroot", "root"]
    }
  ],
  "nodeAttrs": [
    {
      "target": ["autogroup:member"],
      "attr": ["funnel"]
    }
  ]
}
