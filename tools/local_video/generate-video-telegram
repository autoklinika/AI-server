#!/usr/bin/env bash
set -euo pipefail

LTX_BIN="${HERMES_LTX_VIDEO_BIN:-/usr/local/bin/generate-video-ltx23}"
HQ=0
PROMPT_PARTS=()

usage() {
  cat >&2 <<'EOF'
Usage:
  generate-video-telegram [--hq] -- prompt text
  generate-video-telegram hq prompt text
  generate-video-telegram prompt text
EOF
}

while (($#)); do
  case "$1" in
    --hq)
      HQ=1
      shift
      ;;
    hq|HQ)
      if ((${#PROMPT_PARTS[@]} == 0)); then
        HQ=1
        shift
      else
        PROMPT_PARTS+=("$1")
        shift
      fi
      ;;
    --)
      shift
      while (($#)); do PROMPT_PARTS+=("$1"); shift; done
      ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      PROMPT_PARTS+=("$1")
      shift
      ;;
  esac
done

PROMPT="${PROMPT_PARTS[*]-}"
[[ -n "$PROMPT" ]] || { usage; exit 2; }
[[ -x "$LTX_BIN" ]] || { printf 'ERROR: LTX video generator is not executable: %s\n' "$LTX_BIN" >&2; exit 1; }

ARGS=(--prompt "$PROMPT")
if (( HQ == 1 )); then
  ARGS=(--upscale-2x "${ARGS[@]}")
fi

# IMPORTANT: successful stdout must remain the bare absolute MP4 path emitted by
# generate-video-ltx23. Hermes detects that path and returns the file to Telegram.
exec "$LTX_BIN" "${ARGS[@]}"
